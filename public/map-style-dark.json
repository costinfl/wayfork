   "paint": {
    "line-color": "#0f1a26",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     10,
     0.5,
     18,
     4
    ]
   }
  },
  {
